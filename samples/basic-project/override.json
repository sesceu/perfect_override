{
	"checks": {
		"expectedRemoteUser": "vscode",
		"expectedHomeDir": "/home/vscode"
	},
	"extensions": {
		"add": [
			"golang.go",
			"martijnhols.jj-code"
		],
		"remove": [
			"eamodio.gitlens"
		]
	},
	"settings": {
		"add": {
			"editor.formatOnSave": true,
			"git.enabled": false
		}
	},
	"symlinks": [
		{
			"source": ".bashrc",
			"target": ".bashrc_custom"
		}
	],
	"aptPackages": {
		"add": [
			"ripgrep"
		],
		"remove": []
	},
	"commands": [
		"touch /tmp/provision_check",
		"curl -sS https://starship.rs/install.sh | sh -s -- --yes"
	]
}